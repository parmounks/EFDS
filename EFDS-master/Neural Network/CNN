import os
import cv2
import numpy as np
from tensorflow.keras.models import Model
from tensorflow.keras.layers import Input, Conv2D, MaxPooling2D, Flatten, Dense, Lambda
from tensorflow.keras.optimizers import Adam
from tensorflow.keras import backend as K
from sklearn.model_selection import train_test_split

# Paths to folders
base_folder = r"/home/capstoneheroes/EFDS-AI/Neural Network/Fire_Images"
labelled_folder = os.path.join(base_folder, "Labelled")
unlabelled_folder = os.path.join(base_folder, "Unlabelled")

# Image preprocessing
IMG_SIZE = (128, 128)

def load_images(folder, file_list):
    images = []
    for file in file_list:
        img_path = os.path.join(folder, file)
        img = cv2.imread(img_path, cv2.IMREAD_COLOR)
        img = cv2.resize(img, IMG_SIZE)
        images.append(img)
    return np.array(images) / 255.0  # Normalize images

labelled_files = sorted([f for f in os.listdir(labelled_folder) if f.endswith('.png')])
unlabelled_files = sorted([f for f in os.listdir(unlabelled_folder) if f.endswith('.png')])

# Load images
labelled_images = load_images(labelled_folder, labelled_files)
unlabelled_images = load_images(unlabelled_folder, unlabelled_files)

# Create dataset for training
def create_pairs(labelled, unlabelled, labels):
    pairs = []
    pair_labels = []
    for i in range(len(labelled)):
        pairs.append([labelled[i], unlabelled[i]])
        pair_labels.append(labels[i])  # 1 for fire, 0 for no-fire
    return np.array(pairs), np.array(pair_labels)

# Generate synthetic labels (1 for fire, 0 for no-fire)
synthetic_labels = [1 if "fire" in f.lower() else 0 for f in labelled_files]

pairs, labels = create_pairs(labelled_images, unlabelled_images, synthetic_labels)

# Train/test split
pairs_train, pairs_test, labels_train, labels_test = train_test_split(
    pairs, labels, test_size=0.2, random_state=42
)

# Build the SNN
def build_siamese_model(input_shape):
    def build_base_network(input_shape):
        input_layer = Input(shape=input_shape)
        x = Conv2D(64, (3, 3), activation='relu')(input_layer)
        x = MaxPooling2D((2, 2))(x)
        x = Conv2D(128, (3, 3), activation='relu')(x)
        x = MaxPooling2D((2, 2))(x)
        x = Flatten()(x)
        x = Dense(128, activation='relu')(x)
        x = Dense(64, activation='relu')(x)
        return Model(input_layer, x)
    
    input_a = Input(shape=input_shape)
    input_b = Input(shape=input_shape)

    base_network = build_base_network(input_shape)

    encoded_a = base_network(input_a)
    encoded_b = base_network(input_b)

    # Compute L1 distance between encoded feature vectors
    l1_distance = Lambda(lambda tensors: K.abs(tensors[0] - tensors[1]))([encoded_a, encoded_b])
    output = Dense(1, activation='sigmoid')(l1_distance)

    model = Model(inputs=[input_a, input_b], outputs=output)
    return model

input_shape = (*IMG_SIZE, 3)
snn = build_siamese_model(input_shape)

# Compile the model
snn.compile(loss="binary_crossentropy", optimizer=Adam(0.0001), metrics=["accuracy"])

# Train the SNN
history = snn.fit(
    [pairs_train[:, 0], pairs_train[:, 1]],
    labels_train,
    validation_data=([pairs_test[:, 0], pairs_test[:, 1]], labels_test),
    batch_size=16,
    epochs=20
)

# Save the model
snn.save("fire_siamese_model.h5")

# Evaluate the model
loss, acc = snn.evaluate([pairs_test[:, 0], pairs_test[:, 1]], labels_test)
print(f"Test Accuracy: {acc * 100:.2f}%")

# Prediction on new images
def predict_fire(image_a, image_b):
    image_a = cv2.resize(image_a, IMG_SIZE).reshape(1, *IMG_SIZE, 3) / 255.0
    image_b = cv2.resize(image_b, IMG_SIZE).reshape(1, *IMG_SIZE, 3) / 255.0
    prediction = snn.predict([image_a, image_b])[0][0]
    return "Fire" if prediction > 0.5 else "No Fire"

# Example prediction
result = predict_fire(labelled_images[0], unlabelled_images[0])
print(f"Prediction: {result}")
